rules_version = '2';

// Canonical source of truth for the draft-punk-a0735 Firestore rules.
// This Firebase project is shared with Cue Fighters (repo sulkypest/fictional-spoon,
// working dir ~/Downloads/scriptwriter) — its eleven_keys/projects paths are
// deny-all-by-design (Admin SDK / Cloud Function only) and are mirrored here so
// this one file is complete. Deploy rules ONLY from this repo:
//   firebase deploy --only firestore:rules --project draft-punk-a0735
// The Cue Fighters repo's firebase.json intentionally has no "firestore" key so
// its deploys can never overwrite this file again.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Cue Fighters ──────────────────────────────────────────────────────────
    // ElevenLabs keys are written/read only by the Cloud Function via the Admin SDK,
    // which bypasses these rules. Deny all direct client access so a user's browser
    // can never read another user's (or even their own) stored key from Firestore.
    match /eleven_keys/{userId} {
      allow read, write: if false;
    }

    // Script projects, same reasoning — only the Cloud Function (Admin SDK) touches this.
    match /projects/{userId} {
      allow read, write: if false;
    }

    // ── Draft Punk ────────────────────────────────────────────────────────────

    // Age (Nov 2026). Each writer's month and year of birth live in
    // users/{uid}/private/account. Social features (friend requests, messages,
    // groups, chapter sharing) need a birth date showing 16 or over. Age is
    // counted in whole months, rounding down, the same as the app.
    // Writing, versions, notes and the Writing Record are NOT age-checked.
    function accountPath(uid) {
      return /databases/$(database)/documents/users/$(uid)/private/account;
    }
    function oldEnough(uid, minAge) {
      let acc = get(accountPath(uid)).data;
      let years = request.time.year() - acc.birthYear;
      return years > minAge || (years == minAge && request.time.month() > acc.birthMonth);
    }
    // Sender side: must have given a birth date, be 16+, and not be suspended
    function socialOk(uid) {
      return exists(accountPath(uid)) && oldEnough(uid, 16) && !isSuspended(uid);
    }
    // Admin: Ross's account, marked by the claimAdmin server function
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    // A suspended writer can read and export their writing but not add to it
    function isSuspended(uid) {
      return exists(/databases/$(database)/documents/suspended/$(uid));
    }
    // Receiving side: anyone who hasn't answered yet is still reachable (so
    // friends aren't cut off while everyone answers), unless they're under 16
    function canReceive(uid) {
      return !exists(accountPath(uid)) || oldEnough(uid, 16);
    }
    // Friend requests can only be sent TO writers 18 and over (or who haven't
    // answered yet). 16 and 17 year olds can send requests but not receive them.
    function canReceiveRequest(uid) {
      return !exists(accountPath(uid)) || oldEnough(uid, 18);
    }
    // Has `owner` blocked `uid`? (users/{owner}/private/blocks)
    function blocksPath(owner) {
      return /databases/$(database)/documents/users/$(owner)/private/blocks;
    }
    function hasBlocked(owner, uid) {
      return exists(blocksPath(owner)) && uid in get(blocksPath(owner)).data.get('uids', []);
    }


    // Profile doc: username, display name, photo, word totals, friends list
    // (and, until the privacy move finishes for that writer, an old copy of
    // their projects). Owner only since Nov 2026: other writers see the
    // leaderboard record below instead.
    match /users/{userId} {
      allow get, list: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;

      match /writing/{chapterId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId && !isSuspended(userId);

        // Saved versions of a chapter (version history). Owner only.
        match /versions/{versionId} {
          allow read, delete: if request.auth != null && request.auth.uid == userId;
          allow create, update: if request.auth != null && request.auth.uid == userId && !isSuspended(userId);
        }
      }

      // Private copy of notes, beat notes, characters, Word Runner and project
      // data (privacy migration). Owner only. (The 'account' doc has its own
      // rules below.)
      match /private/{docId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId && docId != 'account';
        allow create, update: if request.auth != null && request.auth.uid == userId && docId != 'account'
                              && !(docId == 'data' && isSuspended(userId));
      }

      // Birth date and terms acceptance. Owner only. The birth date can't be
      // changed once given; the terms can be re-accepted. Deletable so account
      // deletion can remove it.
      match /private/account {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId
                      && request.resource.data.birthYear is int
                      && request.resource.data.birthMonth is int
                      && request.resource.data.birthMonth >= 1 && request.resource.data.birthMonth <= 12
                      && request.resource.data.birthYear >= 1900
                      && request.resource.data.birthYear <= request.time.year();
        allow update: if request.auth != null && request.auth.uid == userId
                      && request.resource.data.birthYear == resource.data.birthYear
                      && request.resource.data.birthMonth == resource.data.birthMonth;
      }

      // Writing Record: how text was entered, per chapter. Owner only.
      match /evidence/{chapterId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Leaderboard record: username and word counts only. Readable by any
    // signed-in writer (leaderboards, friends' and group word counts). Only
    // the owner can write it, only these fields, and only under the username
    // they actually hold.
    match /leaderboard/{userId} {
      allow get, list: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId
                            && request.resource.data.keys().hasOnly(['username', 'totalWords', 'wordsThisWeek', 'wordsThisMonth', 'wordsThisYear', 'weekEndsAt', 'monthEndsAt', 'yearEndsAt'])
                            && request.resource.data.username is string
                            && get(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == request.auth.uid;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Suspensions. Set and lifted by the admin only; the writer can see
    // their own, so the app can explain it.
    match /suspended/{userId} {
      allow get: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow list, write: if isAdmin();
    }

    // Notices (announcements) written in the admin area. Any signed-in
    // writer can read them; only the admin can write them.
    match /announcements/{noticeId} {
      allow get, list: if request.auth != null;
      allow write: if isAdmin();
    }

    // Weekly numbers, written by the server for the admin page
    match /ops/{docId} {
      allow get: if isAdmin() && docId == 'weeklyNumbers';
    }

    // Reports of messages, requests, shared chapters or writers. Anyone
    // signed in can send one; only the admin can read them and mark them
    // dealt with (a server function also emails them to Sulk Media).
    match /reports/{reportId} {
      allow get, list: if isAdmin();
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'adminNote', 'handledAt']);
      allow create: if request.auth != null
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.keys().hasOnly(['from', 'type', 'targetUid', 'targetUsername', 'path', 'excerpt', 'reason', 'note', 'createdAt'])
                    && request.resource.data.excerpt is string && request.resource.data.excerpt.size() <= 600
                    && request.resource.data.note is string && request.resource.data.note.size() <= 1000;
    }

    // Writing Record share links. Anyone with the link (an unguessable id) can
    // read one report; nobody can list them. Only the writer can create,
    // replace or delete their own.
    match /evidenceShares/{shareId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.auth != null && request.resource.data.uid == request.auth.uid
                            && (resource == null || resource.data.uid == request.auth.uid);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // username -> uid reservation. Readable by any signed-in user (availability
    // checks, friend lookups by username); only claimable/removable by the uid
    // it points to. An existing name can only be updated by its owner (before
    // Nov 2026 anyone could overwrite someone else's).
    match /usernames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /friendRequests/{requestId} {
      allow get: if request.auth != null &&
        (resource == null || resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow list: if request.auth != null &&
        (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid
                    && socialOk(request.auth.uid) && canReceiveRequest(request.resource.data.to)
                    && !hasBlocked(request.resource.data.to, request.auth.uid);
      allow delete: if request.auth != null &&
        (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
    }

    // Cross-user notification: the accepter writes this for the original
    // sender to pick up on their next sign-in.
    match /friendAcceptances/{acceptanceId} {
      allow create: if request.auth != null && request.resource.data.addFriend == request.auth.uid
                    && socialOk(request.auth.uid);
      allow read, delete: if request.auth != null && resource.data.addTo == request.auth.uid;
    }

    match /messages/{messageId} {
      allow get: if isAdmin() || (request.auth != null &&
        (resource == null || resource.data.to == request.auth.uid || resource.data.from == request.auth.uid));
      allow list: if request.auth != null &&
        (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      // Direct messages: 16+ only, and only to someone who has you as a friend
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid
                    && socialOk(request.auth.uid)
                    && canReceive(request.resource.data.to)
                    && !hasBlocked(request.resource.data.to, request.auth.uid)
                    && request.auth.uid in get(/databases/$(database)/documents/users/$(request.resource.data.to)).data.get('friends', []);
      allow update: if request.auth != null && resource.data.to == request.auth.uid;
      allow delete: if isAdmin() || (request.auth != null &&
        (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid));
    }

    // Writing groups (group chat and group word counts). Only members can see
    // a group; only the creator can change it, except that any other member
    // may remove themselves. At most 12 members.
    match /groups/{groupId} {
      allow get, list: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
                    && socialOk(request.auth.uid)
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.members is list
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.members.size() <= 12
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 60;
      allow update: if request.auth != null && (
                      (resource.data.ownerId == request.auth.uid
                        && socialOk(request.auth.uid)
                        && request.resource.data.ownerId == request.auth.uid
                        && request.auth.uid in request.resource.data.members
                        && request.resource.data.members.size() <= 12
                        && request.resource.data.name.size() <= 60)
                      ||
                      (request.auth.uid in resource.data.members
                        && request.auth.uid != resource.data.ownerId
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
                        && request.resource.data.members.toSet() == resource.data.members.toSet().difference([request.auth.uid].toSet()))
                    );
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;

      // Messages in a group: members read and post (as themselves); writers can
      // always find their own (so account deletion can remove them); the
      // sender or the group's creator can delete.
      match /messages/{messageId} {
        allow read: if isAdmin() || request.auth != null
                    && (resource.data.from == request.auth.uid
                        || request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members);
        allow create: if request.auth != null
                      && request.resource.data.from == request.auth.uid
                      && socialOk(request.auth.uid)
                      && request.resource.data.body is string
                      && request.resource.data.body.size() <= 500
                      && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
        allow delete: if isAdmin() || request.auth != null
                      && (resource.data.from == request.auth.uid
                          || get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid);
      }
    }

    match /shares/{shareId} {
      allow get: if isAdmin() || request.auth != null &&
        (resource == null || resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.sharedWith);
      allow list: if request.auth != null &&
        (resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.sharedWith);
      // Sharing a chapter is 16+. Anyone can still narrow an existing share
      // (remove people) whatever their age. Only the owner can change a share
      // (before Nov 2026 anyone who knew a share's id could overwrite it).
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid
                    && socialOk(request.auth.uid);
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == request.auth.uid
                    && (socialOk(request.auth.uid)
                        || resource.data.get('sharedWith', []).toSet().hasAll(request.resource.data.get('sharedWith', [])));
      allow delete: if isAdmin() || (request.auth != null &&
        (resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.sharedWith));
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
