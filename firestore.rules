rules_version = '2';

// Canonical source of truth for the draft-punk-a0735 Firestore rules.
// This Firebase project is shared with Cue Fighters (repo sulkypest/fictional-spoon,
// working dir ~/Downloads/scriptwriter) — its eleven_keys/projects paths are
// deny-all-by-design (Admin SDK / Cloud Function only) and are mirrored here so
// this one file is complete. Deploy rules ONLY from this repo:
//   firebase deploy --only firestore:rules --project draft-punk-a0735
// The Cue Fighters repo's firebase.json intentionally has no "firestore" key so
// its deploys can never overwrite this file again.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Cue Fighters ──────────────────────────────────────────────────────────
    // ElevenLabs keys are written/read only by the Cloud Function via the Admin SDK,
    // which bypasses these rules. Deny all direct client access so a user's browser
    // can never read another user's (or even their own) stored key from Firestore.
    match /eleven_keys/{userId} {
      allow read, write: if false;
    }

    // Script projects, same reasoning — only the Cloud Function (Admin SDK) touches this.
    match /projects/{userId} {
      allow read, write: if false;
    }

    // ── Draft Punk ────────────────────────────────────────────────────────────

    // Public profile doc: username, display name, word totals, friends list.
    // Readable by any signed-in user (leaderboard, friend lookups); writable
    // only by its owner.
    match /users/{userId} {
      allow get, list: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      match /writing/{chapterId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // Saved versions of a chapter (version history). Owner only.
        match /versions/{versionId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      // Private copy of notes, beat notes, characters, Word Runner and project
      // data (privacy migration). Owner only.
      match /private/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Writing Record: how text was entered, per chapter. Owner only.
      match /evidence/{chapterId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Writing Record share links. Anyone with the link (an unguessable id) can
    // read one report; nobody can list them. Only the writer can create,
    // replace or delete their own.
    match /evidenceShares/{shareId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.auth != null && request.resource.data.uid == request.auth.uid
                            && (resource == null || resource.data.uid == request.auth.uid);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // username -> uid reservation. Readable by any signed-in user (availability
    // checks, friend lookups by username); only claimable/removable by the uid
    // it points to.
    match /usernames/{name} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /friendRequests/{requestId} {
      allow get: if request.auth != null &&
        (resource == null || resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow list: if request.auth != null &&
        (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid;
      allow delete: if request.auth != null &&
        (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
    }

    // Cross-user notification: the accepter writes this for the original
    // sender to pick up on their next sign-in.
    match /friendAcceptances/{acceptanceId} {
      allow create: if request.auth != null && request.resource.data.addFriend == request.auth.uid;
      allow read, delete: if request.auth != null && resource.data.addTo == request.auth.uid;
    }

    match /messages/{messageId} {
      allow get: if request.auth != null &&
        (resource == null || resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow list: if request.auth != null &&
        (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid;
      allow update: if request.auth != null && resource.data.to == request.auth.uid;
      allow delete: if request.auth != null &&
        (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
    }

    // Writing groups (group chat and group word counts). Only members can see
    // a group; only the creator can change it, except that any other member
    // may remove themselves. At most 12 members.
    match /groups/{groupId} {
      allow get, list: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.members is list
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.members.size() <= 12
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 60;
      allow update: if request.auth != null && (
                      (resource.data.ownerId == request.auth.uid
                        && request.resource.data.ownerId == request.auth.uid
                        && request.auth.uid in request.resource.data.members
                        && request.resource.data.members.size() <= 12
                        && request.resource.data.name.size() <= 60)
                      ||
                      (request.auth.uid in resource.data.members
                        && request.auth.uid != resource.data.ownerId
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
                        && request.resource.data.members.toSet() == resource.data.members.toSet().difference([request.auth.uid].toSet()))
                    );
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;

      // Messages in a group: members read and post (as themselves); writers can
      // always find their own (so account deletion can remove them); the
      // sender or the group's creator can delete.
      match /messages/{messageId} {
        allow read: if request.auth != null
                    && (resource.data.from == request.auth.uid
                        || request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members);
        allow create: if request.auth != null
                      && request.resource.data.from == request.auth.uid
                      && request.resource.data.body is string
                      && request.resource.data.body.size() <= 500
                      && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
        allow delete: if request.auth != null
                      && (resource.data.from == request.auth.uid
                          || get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid);
      }
    }

    match /shares/{shareId} {
      allow get: if request.auth != null &&
        (resource == null || resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.sharedWith);
      allow list: if request.auth != null &&
        (resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.sharedWith);
      allow create, update: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow delete: if request.auth != null &&
        (resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.sharedWith);
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
